# Copy to .env (gitignored) and fill in real values before `docker compose up`.
# Compose reads .env automatically and substitutes ${VAR:-default} in
# docker-compose.yml.

# Lichess integration (optional). Leave empty to run with the integration
# disabled. Tokens come from https://lichess.org/account/oauth/token.
#   - LICHESS_BOARD_TOKEN: human plays via the Board API.
#   - LICHESS_BOT_TOKEN:   engine plays via the Bot API. Requires that the
#                          account was upgraded to BOT (irreversible).
LICHESS_BASE_URL=https://lichess.org
LICHESS_BOARD_TOKEN=
LICHESS_BOT_TOKEN=

# Persistence backend selector: "mongo", "postgres", or unset to disable.
# ALMACHESS_DB=mongo

# AI engine selector for the ai-service container (default: stockfish).
# AI_ENGINE=stockfish
# STOCKFISH_PATH=/usr/games/stockfish

# Akka license key. Without one the actor systems terminate after ~15
# minutes ("Akka terminated. Obtain free keys at https://akka.io/key").
# Register a free key at https://akka.io/key and paste it here.
AKKA_LICENSE_KEY=
# expires in 45 days status:12.05.26
